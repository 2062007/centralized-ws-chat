# ============================================================
#  Copy file này thành .env:  cp .env.example .env
#  Tạo chuỗi ngẫu nhiên:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# ---------- BẮT BUỘC ----------
# Khoá ký JWT (>= 16 ký tự). Server từ chối khởi động nếu thiếu hoặc giữ nguyên giá trị mẫu.
# Đổi giá trị này sẽ làm mọi người dùng phải đăng nhập lại.
JWT_SECRET=your_jwt_secret_here

# Khoá mã hoá dữ liệu node sync (>= 16 ký tự, độ dài tuỳ ý, server tự băm SHA-256 thành khoá AES-256).
# KHÔNG đổi sau khi đã có node lưu dữ liệu, nếu không sẽ không khôi phục được.
MASTER_KEY=your_32_byte_master_key_for_node_encryption

# ---------- TUỲ CHỌN ----------
# Cổng lắng nghe. Render tự cấp PORT nên không cần đặt khi deploy ở đó.
PORT=3000

# Đường dẫn file SQLite. Mặc định: server/chat.db
# Trên Render hãy trỏ vào ổ đĩa bền vững (vd. /var/data/chat.db), nếu không dữ liệu mất khi redeploy.
# DB_PATH=./chat.db

# Kiểm duyệt bằng Gemini: để trống = tắt kiểm duyệt.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Token cho POST /api/admin/restore (khôi phục dữ liệu từ node client).
# Để trống = tắt endpoint. Gọi:
#   curl -X POST https://your-app/api/admin/restore -H "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=

# ============================================================
#  Biến môi trường phía Python client (đặt trong shell, KHÔNG phải file .env của server)
# ============================================================
# CHAT_SERVER_URL=https://your-app.onrender.com
# CHAT_INSECURE_SSL=1     # chỉ dùng khi server có chứng chỉ tự ký (localhost đã tự bỏ qua)
