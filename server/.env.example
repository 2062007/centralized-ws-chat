# Bắt buộc (>= 16 ký tự, nên ngẫu nhiên dài). Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
MASTER_KEY=your_32_byte_master_key_for_node_encryption

# Tuỳ chọn
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Token cho endpoint POST /api/admin/restore (bỏ trống = tắt endpoint)
ADMIN_TOKEN=
PORT=3000
